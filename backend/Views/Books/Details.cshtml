@model LMS.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<div class="max-w-3xl mx-auto">
    <div class="d-flex justify-between items-center mb-4">
        <h1>Book Details</h1>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="card p-6 mb-4">
        <h2 class="text-xl mb-4 border-b pb-2">@Model.Name</h2>
        
        <div class="grid grid-cols-2 gap-6">
            <div>
                <dl class="grid grid-cols-2 gap-2">
                    <dt class="font-bold text-secondary">Serial Number:</dt>
                    <dd>@Model.SerialNumber</dd>
                    
                    <dt class="font-bold text-secondary">ISBN:</dt>
                    <dd>@Model.ISBN</dd>
                    
                    <dt class="font-bold text-secondary">Author:</dt>
                    <dd>@Model.Author</dd>
                    
                    <dt class="font-bold text-secondary">Publisher:</dt>
                    <dd>@Model.Publisher</dd>
                    
                    <dt class="font-bold text-secondary">Subject:</dt>
                    <dd>@Model.Subject</dd>
                </dl>
            </div>
            
            <div>
                <dl class="grid grid-cols-2 gap-2">
                    <dt class="font-bold text-secondary">Course:</dt>
                    <dd>@(Model.Course != null ? Model.Course.Name : "N/A")</dd>
                    
                    <dt class="font-bold text-secondary">Published Date:</dt>
                    <dd>@Model.PublishedDate.ToShortDateString()</dd>
                    
                    <dt class="font-bold text-secondary">Edition:</dt>
                    <dd>@Model.Edition</dd>
                    
                    <dt class="font-bold text-secondary">Pages:</dt>
                    <dd>@Model.Pages</dd>
                    
                    <dt class="font-bold text-secondary">Rack Number:</dt>
                    <dd>@Model.RackNumber</dd>
                </dl>
            </div>
        </div>
        
        <div class="mt-6 pt-4 border-t grid grid-cols-2 gap-6">
            <div>
                <span class="font-bold text-secondary">Stock:</span>
                <span class="badge @(Model.Stock > 0 ? "bg-success" : "bg-danger") ml-2">@Model.Stock</span>
            </div>
            <div>
                <span class="font-bold text-secondary">Status:</span>
                <span class="badge bg-secondary ml-2">@Model.Status</span>
            </div>
        </div>
    </div>
</div>
