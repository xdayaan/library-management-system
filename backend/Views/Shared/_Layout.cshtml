@using Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LMS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Outfit', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a',
                        }
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="h-full font-sans antialiased text-slate-800">
    <div class="min-h-full flex flex-col">
        <!-- Navigation -->
        <nav class="bg-white border-b border-slate-200 sticky top-0 z-50 backdrop-blur-lg bg-opacity-90">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-16">
                    <div class="flex">
                        <div class="flex-shrink-0 flex items-center pr-8 border-r border-slate-100">
                            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 group">
                                <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-brand-600 to-brand-800 text-white flex items-center justify-center shadow-md group-hover:shadow-lg group-hover:scale-105 transition-all duration-200">
                                    <i class="fas fa-book-reader text-sm"></i>
                                </div>
                                <span class="font-bold text-xl tracking-tight text-slate-800 group-hover:text-brand-700 transition-colors">LMS</span>
                            </a>
                        </div>
                        
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var controller = ViewContext.RouteData.Values["controller"]?.ToString();
                            var action = ViewContext.RouteData.Values["action"]?.ToString();
                            
                            <div class="hidden sm:ml-6 sm:flex sm:space-x-2 items-center">
                                <a asp-controller="Record" asp-action="Index" 
                                   class="@(controller == "Record" && action != "Create" ? "bg-brand-50 text-brand-700 font-semibold shadow-sm ring-1 ring-brand-100" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900 font-medium") px-3 py-2 rounded-md text-sm transition-all duration-200 flex items-center gap-2">
                                   <i class="fas fa-chart-pie @(controller == "Record" && action != "Create" ? "text-brand-500" : "text-slate-400") text-xs"></i> 
                                   Dashboard
                                </a>
                                <a asp-controller="Books" asp-action="Index" 
                                   class="@(controller == "Books" ? "bg-brand-50 text-brand-700 font-semibold shadow-sm ring-1 ring-brand-100" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900 font-medium") px-3 py-2 rounded-md text-sm transition-all duration-200 flex items-center gap-2">
                                   <i class="fas fa-book @(controller == "Books" ? "text-brand-500" : "text-slate-400") text-xs"></i> 
                                   Books
                                </a>
                                <a asp-controller="Students" asp-action="Index" 
                                   class="@(controller == "Students" ? "bg-brand-50 text-brand-700 font-semibold shadow-sm ring-1 ring-brand-100" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900 font-medium") px-3 py-2 rounded-md text-sm transition-all duration-200 flex items-center gap-2">
                                   <i class="fas fa-users @(controller == "Students" ? "text-brand-500" : "text-slate-400") text-xs"></i> 
                                   Students
                                </a>
                                <a asp-controller="Courses" asp-action="Index" 
                                   class="@(controller == "Courses" ? "bg-brand-50 text-brand-700 font-semibold shadow-sm ring-1 ring-brand-100" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900 font-medium") px-3 py-2 rounded-md text-sm transition-all duration-200 flex items-center gap-2">
                                   <i class="fas fa-graduation-cap @(controller == "Courses" ? "text-brand-500" : "text-slate-400") text-xs"></i> 
                                   Courses
                                </a>
                            </div>
                        }
                    </div>
                    
                    <div class="flex items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="flex items-center gap-4">
                                <a asp-controller="Record" asp-action="Create" class="hidden md:inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-full text-white bg-brand-600 hover:bg-brand-700 shadow-sm hover:shadow-md transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-500">
                                    <i class="fas fa-plus mr-2 text-xs"></i> Issue Book
                                </a>
                                
                                <div class="ml-3 relative flex items-center gap-3 pl-4 border-l border-slate-200">
                                    <span class="text-sm font-medium text-slate-700">@User.Identity.Name</span>
                                    <form asp-controller="Librarian" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit" class="text-slate-400 hover:text-rose-500 transition-colors duration-200 p-1 rounded-full hover:bg-rose-50" title="Logout">
                                            <i class="fas fa-power-off"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="flex-grow">
            <div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
                @RenderBody()
            </div>
        </main>

        <!-- Footer -->
        <footer class="bg-white border-t border-slate-200">
            <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center">
                    <p class="text-base text-slate-400 text-sm">
                        &copy; @DateTime.Now.Year LMS. All rights reserved.
                    </p>
                    <div class="flex space-x-6 text-sm text-slate-400">
                        <a asp-controller="Home" asp-action="Privacy" class="hover:text-brand-600 transition-colors">Privacy Policy</a>
                        <a href="#" class="hover:text-brand-600 transition-colors">Terms of Service</a>
                    </div>
                </div>
            </div>
        </footer>
    </div>
    
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
