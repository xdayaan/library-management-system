@model IEnumerable<LMS.Models.Student>
@{
    ViewData["Title"] = "Students";
}

<div class="d-flex justify-between items-center mb-4">
    <h1>Students</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add New Student
    </a>
</div>

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Roll Number</th>
                <th>Email</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td>#@student.Id</td>
                    <td>@student.RollNumber</td>
                    <td>@student.Email</td>
                    <td class="text-center">
                        <div class="d-flex gap-2 justify-center">
                            <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-secondary"><i class="fas fa-edit"></i></a>
                            <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-secondary"><i class="fas fa-info-circle"></i></a>
                            <a asp-action="Delete" asp-route-id="@student.Id" class="btn btn-danger"><i class="fas fa-trash"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>