@model LMS.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<div class="max-w-2xl mx-auto">
    <div class="card p-6 border-danger">
        <div class="text-center mb-6">
            <div class="text-danger text-4xl mb-4">
                <i class="fas fa-exclamation-circle"></i>
            </div>
            <h1 class="text-2xl text-danger mb-2">Delete Student?</h1>
            <p class="text-secondary">Are you sure you want to delete this student? This action cannot be undone.</p>
        </div>

        <div class="bg-slate-50 p-4 rounded mb-6">
            <div class="d-flex items-center gap-4">
                @if (!string.IsNullOrEmpty(Model.Photo))
                {
                    <img src="@Model.Photo" alt="@Model.Name" class="w-16 h-16 rounded-full object-cover" />
                }
                <dl class="grid grid-cols-2 gap-2 flex-grow">
                    <dt class="font-bold">Name:</dt>
                    <dd>@Model.Name</dd>
                    
                    <dt class="font-bold">Roll Number:</dt>
                    <dd>@Model.RollNumber</dd>
                    
                    <dt class="font-bold">Email:</dt>
                    <dd>@Model.Email</dd>
                </dl>
            </div>
        </div>

        <form asp-action="Delete" class="d-flex justify-center gap-4">
            <input type="hidden" asp-for="Id" />
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-danger">Delete Student</button>
        </form>
    </div>
</div>
