@model LMS.Models.Record

@{
    ViewData["Title"] = "Edit Record";
}

<div class="max-w-xl mx-auto">
    <div class="d-flex justify-between items-center mb-4">
        <h1>Edit Record</h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="card p-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="IssueDate" />

            <div class="form-group mb-4">
                <label asp-for="BookId" class="control-label">Book</label>
                <select asp-for="BookId" class="form-control" asp-items="@(new SelectList(ViewBag.Books, "Id", "Name"))" readonly disabled></select>
                <input type="hidden" asp-for="BookId" />
                <span asp-validation-for="BookId" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="StudentId" class="control-label">Student</label>
                <select asp-for="StudentId" class="form-control" asp-items="@(new SelectList(ViewBag.Students, "Id", "Name"))" readonly disabled></select>
                <input type="hidden" asp-for="StudentId" />
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="DueDate" class="control-label">Due Date</label>
                <input asp-for="DueDate" class="form-control" type="date" />
                <span asp-validation-for="DueDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="ReturnDate" class="control-label">Return Date</label>
                <input asp-for="ReturnDate" class="form-control" type="date" />
                <span asp-validation-for="ReturnDate" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-4">
                <label asp-for="Fine" class="control-label">Fine Amount</label>
                <input asp-for="Fine" class="form-control" />
                <span asp-validation-for="Fine" class="text-danger"></span>
            </div>

            <div class="d-flex justify-end mt-4">
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
