@model LMS.Models.Record

@{
    ViewData["Title"] = "Issue New Book";
}

<div class="max-w-xl mx-auto">
    <div class="d-flex justify-between items-center mb-4">
        <h1>Issue New Book</h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="card p-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

            <div class="form-group mb-4">
                <label asp-for="BookId" class="control-label">Select Book</label>
                <select asp-for="BookId" class="form-control select-search" asp-items="@(new SelectList(ViewBag.Books, "Id", "Name"))">
                    <option value="">-- Select Book --</option>
                </select>
                <span asp-validation-for="BookId" class="text-danger"></span>
                <p class="text-sm text-secondary mt-1">Only books with stock > 0 are listed.</p>
            </div>

            <div class="form-group mb-4">
                <label asp-for="StudentId" class="control-label">Select Student</label>
                <select asp-for="StudentId" class="form-control select-search" asp-items="@(new SelectList(ViewBag.Students, "Id", "Name"))">
                    <option value="">-- Select Student --</option>
                </select>
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>

            <div class="d-flex justify-end mt-4">
                <button type="submit" class="btn btn-primary">Issue Book</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
