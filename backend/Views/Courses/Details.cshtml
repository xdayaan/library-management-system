@model LMS.Models.Course

@{
    ViewData["Title"] = "Course Details";
}

<div class="max-w-2xl mx-auto">
    <div class="d-flex justify-between items-center mb-4">
        <h1>Course Details</h1>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">
                <i class="fas fa-edit"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="card p-6 mb-4">
        <h2 class="text-xl mb-4 border-b pb-2">@Model.Name</h2>
        
        <div class="grid grid-cols-2 gap-6">
            <div>
                <dl class="grid grid-cols-2 gap-2">
                    <dt class="font-bold text-secondary">Created On:</dt>
                    <dd>@Model.CreatedOn.ToShortDateString()</dd>
                    
                    <dt class="font-bold text-secondary">Last Updated:</dt>
                    <dd>@Model.UpdatedOn.ToShortDateString()</dd>
                </dl>
            </div>
        </div>
        
        <div class="mt-6 pt-4 border-t grid grid-cols-2 gap-6">
            <div>
                <span class="font-bold text-secondary">Total Books:</span>
                <span class="badge bg-info ml-2">@(Model.Books?.Count ?? 0)</span>
            </div>
            <div>
                <span class="font-bold text-secondary">Total Students:</span>
                <span class="badge bg-info ml-2">@(Model.Students?.Count ?? 0)</span>
            </div>
        </div>
    </div>
</div>
