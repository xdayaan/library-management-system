@model IEnumerable<LMS.Models.Course>

@{
    ViewData["Title"] = "Courses";
}

<div class="d-flex justify-between items-center mb-4">
    <h1>Courses</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add New Course
    </a>
</div>

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model)
            {
                <tr>
                    <td>#@course.Id</td>
                    <td>@course.Name</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-secondary"><i class="fas fa-edit"></i></a>
                        <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-secondary"><i class="fas fa-info-circle"></i></a>
                        <a asp-action="Delete" asp-route-id="@course.Id" class="btn btn-danger"><i class="fas fa-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>